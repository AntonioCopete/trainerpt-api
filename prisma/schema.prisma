// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"

}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  trainer
  member
}

enum AssignmentStatus {
  pending
  completed
  missed
  archived
}

enum RepeatCadence {
  none
  weekly
  monthly
}

enum RoutineAssignmentStatus {
  scheduled
  active
  expired
  archived
}

enum ExerciseSource {
  wger
  free_exercise_db
  custom
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum ResourceType {
  diet
  routine
  general
}

model User {
  /// Supabase auth.users.id (UUID)
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @db.VarChar(255)
  role      UserRole? 

  avatarUrl String?  @db.VarChar(1024)
  auth_provider String   @db.VarChar(50)

  deleted       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trainer <-> Member relationships
  trainerLinks TrainerMemberLink[] @relation("Trainer")
  memberLinks  TrainerMemberLink[] @relation("Member")

  invitesAsTrainer TrainerInvite[] @relation("InviteTrainer")
  invitesAsMember  TrainerInvite[] @relation("InviteMember")

  // Forms
  formTemplates             FormTemplate[]   @relation("TemplateTrainer")
  formAssignmentsAsTrainer  FormAssignment[] @relation("AssignmentTrainer")
  formAssignmentsAsMember   FormAssignment[] @relation("AssignmentMember")
  formResponses             FormResponse[]
  routineTemplates          RoutineTemplate[]   @relation("RoutineTemplateTrainer")
  routineAssignmentsAsTrainer RoutineAssignment[] @relation("RoutineAssignmentTrainer")
  routineAssignmentsAsMember  RoutineAssignment[] @relation("RoutineAssignmentMember")
  customExercises           Exercise[] @relation("ExerciseCreator")
  
  subscriptions             Subscription[]

  resourcesAsTrainer Resource[]       @relation("ResourceTrainer")
  resourceShares     ResourceShare[]

  // Index
  @@index([id])
}

model Resource {
  id           String       @id @default(uuid()) @db.Uuid
  trainerId    String       @db.Uuid
  title        String       @db.VarChar(500)
  description  String?      @db.VarChar(2000)
  resourceType ResourceType
  filename     String       @db.VarChar(512)
  contentType  String       @db.VarChar(200)
  size         Int?
  /// GCS object key after upload-url is issued (or after successful upload policy)
  storageKey   String?      @db.VarChar(1024)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  trainer User            @relation("ResourceTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  shares  ResourceShare[]

  @@index([trainerId, resourceType])
  @@index([trainerId, createdAt])
}

model ResourceShare {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @db.Uuid
  memberId   String   @db.Uuid
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  member   User     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([resourceId, memberId])
  @@index([memberId])
}

enum TrainerInviteStatus {
  pending
  accepted
  cancelled
  expired
}

model TrainerInvite {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @db.Uuid
  memberId  String?  @db.Uuid

  email     String?   @db.VarChar(255)
  code      String   @unique @db.VarChar(32)

  status    TrainerInviteStatus @default(pending)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  acceptedAt DateTime?

  trainer User  @relation("InviteTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  member  User? @relation("InviteMember", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([trainerId, status])
  @@index([email, status])
}

model TrainerMemberLink {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @db.Uuid
  memberId  String   @db.Uuid
  createdAt DateTime @default(now())

  trainer User @relation("Trainer", fields: [trainerId], references: [id], onDelete: Cascade)
  member  User @relation("Member",  fields: [memberId],  references: [id], onDelete: Cascade)

  @@unique([trainerId, memberId])
  @@index([trainerId])
  @@index([memberId])
}

model FormTemplate {
  id                String   @id @default(uuid()) @db.Uuid
  trainerId         String   @db.Uuid
  name              String   @db.VarChar(120)
  description       String   @db.VarChar(256)

  /// JSON schema for the form (fields, types, required, ordering, etc.)
  schema     Json

  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trainer    User           @relation("TemplateTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  assignments FormAssignment[]

  @@index([trainerId, isArchived, deletedAt])
  @@index([trainerId])
  @@unique([trainerId, name]) // optional, can remove if you want duplicate names
}

model FormAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  trainerId      String  @db.Uuid
  memberId       String  @db.Uuid

  /// If you enforce "send only from templates", make this required (remove '?').
  templateId     String? @db.Uuid

  /// Snapshot of schema at send time (recommended even if templateId exists)
  schemaSnapshot Json

  status         AssignmentStatus @default(pending)
  dueAt          DateTime?
  windowStart    DateTime? // dueAt - 72h (when member can start responding)
  repeat         RepeatCadence    @default(none)
  nextDueAt      DateTime? // Deprecated, use parentAssignmentId chain instead

  /// For recurring assignments, points to the previous assignment in the chain
  parentAssignmentId String? @db.Uuid

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// UTC instant when the "window opened" reminder email was successfully sent (idempotency).
  reminderWindowSentAt DateTime?
  /// UTC instant when the "last day to submit" reminder email was successfully sent (idempotency).
  reminderDueSentAt    DateTime?

  trainer  User         @relation("AssignmentTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  member   User         @relation("AssignmentMember",  fields: [memberId],  references: [id], onDelete: Cascade)
  template FormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  responses FormResponse[]
  
  // Self-referential relation for recurring chain
  parent   FormAssignment?  @relation("RecurringChain", fields: [parentAssignmentId], references: [id], onDelete: SetNull)
  children FormAssignment[] @relation("RecurringChain")

  @@index([memberId, status])
  @@index([trainerId, createdAt])
  @@index([templateId])
  @@index([status, dueAt]) // For cron job to find overdue assignments
}

model FormResponse {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  memberId     String   @db.Uuid

  /// Answers: { fieldId: value }
  answers      Json

  submittedAt  DateTime @default(now())

  assignment FormAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     User           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([assignmentId, submittedAt])
  @@index([memberId, submittedAt])
}

model RoutineTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  trainerId   String   @db.Uuid
  name        String   @db.VarChar(120)
  description String   @db.VarChar(256)
  schema      Json
  isArchived  Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainer     User                @relation("RoutineTemplateTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  assignments RoutineAssignment[]

  @@index([trainerId, isArchived, deletedAt])
  @@index([trainerId])
}

model RoutineAssignment {
  id             String                  @id @default(uuid()) @db.Uuid
  trainerId      String                  @db.Uuid
  memberId       String                  @db.Uuid
  templateId     String?                 @db.Uuid
  schemaSnapshot Json
  startDate      DateTime
  endDate        DateTime
  status         RoutineAssignmentStatus @default(scheduled)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  trainer User            @relation("RoutineAssignmentTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  member  User            @relation("RoutineAssignmentMember", fields: [memberId], references: [id], onDelete: Cascade)
  template RoutineTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([memberId, status, startDate, endDate])
  @@index([trainerId, memberId, startDate, endDate])
  @@index([templateId])
}

model Exercise {
  id               String         @id @default(uuid()) @db.Uuid
  source           ExerciseSource
  externalId       Int?
  trainerId        String?        @db.Uuid
  externalUuid     String?        @db.VarChar(64)
  name             String         @db.VarChar(255)
  nameEs           String?        @db.VarChar(255)
  description      Json?
  descriptionEs    Json?
  categoryId       Int?
  categoryName     String?        @db.VarChar(120)
  categoryNameEs   String?        @db.VarChar(120)
  equipment        Json?
  equipmentEs      Json?
  muscles          Json?
  musclesEs        Json?
  musclesSecondary Json?
  musclesSecondaryEs Json?
  images           Json?
  videos           Json?
  license          Json?
  lastUpdateAt     DateTime?
  lastUpdateGlobal DateTime?
  raw              Json
  isArchived       Boolean        @default(false)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  trainer          User?          @relation("ExerciseCreator", fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([categoryName])
  @@index([trainerId])
  @@index([source, externalId])
  @@index([isArchived, deletedAt])
  @@unique([source, externalId])
}

model Muscle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  nameEs    String   @db.VarChar(100)
  order     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([nameEs])
}

model Subscription {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  
  stripeCustomerId     String?  @db.VarChar(255)
  stripeSubscriptionId String?  @db.VarChar(255)
  stripeEventId        String?  @db.VarChar(255)
  
  startedAt            DateTime @default(now())
  endsAt               DateTime?
  canceledAt           DateTime?
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@index([userId, status])
  @@index([stripeEventId])
}

